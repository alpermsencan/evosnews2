{
  "name": "newssite",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build --webpack && node scripts/prepare-standalone.mjs",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "eslint",
    "test:ingest": "node --test tests/ingest.test.mjs",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:purge-seed": "node --env-file=.env prisma/purge-seed.mjs",
    "db:vehicles": "node --env-file=.env prisma/import-vehicles.mjs",
    "db:tariffs": "node --env-file=.env prisma/import-tariffs.mjs",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "test:security": "node --test tests/security.test.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.10.0",
    "dompurify": "^3.4.17",
    "jose": "^6.2.8",
    "mongodb": "^6.0.0",
    "next": "^16.4.6",
    "quill": "2.0.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sanitize-html": "^2.18.2",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/dom-speech-recognition": "^0.0.12",
    "@types/google.maps": "^3.66.10",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.2",
    "eslint": "^9",
    "eslint-config-next": "^16.4.6",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "nanoid": "^3.3.18",
    "js-yaml": "^4.3.2",
    "deepmerge-ts": "^8.0.0",
    "postcss": "^8.5.23",
    "sharp": "^0.35.5",
    "source-map-js": "^1.2.2",
    "minimatch": "^11.0.8",
    "zod": "^4.6.7"
  }
}
