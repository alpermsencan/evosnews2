# Database connection URL (MongoDB)
DATABASE_URL="mongodb+srv://user:pass@cluster.mongodb.net/dbname?appName=Cluster"

# Admin panel credentials
ADMIN_PASSWORD="your-secure-admin-password"

# Authorization secret for sessions
AUTH_SECRET="your-64-character-hex-auth-secret"

# Cron trigger authorization secret
CRON_SECRET="your-cron-secret-key"

# Cloudinary credentials for vehicle image sync
CLOUDINARY_URL="cloudinary://api_key:api_secret@cloud_name"
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"
CLOUDINARY_FOLDER="evos"
