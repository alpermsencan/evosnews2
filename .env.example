# ========================================================
# EVOtoPilot — Hostinger & Production Ortam Değişkenleri
# ========================================================
# Hostinger hPanel -> Advanced -> Node.js -> Environment Variables
# bölümüne bu değişkenleri eklemeniz gerekmektedir.

# 1. MongoDB Veritabanı Bağlantısı (Zorunlu)
DATABASE_URL="mongodb+srv://<kullanici>:<sifre>@<cluster>.mongodb.net/evos?retryWrites=true&w=majority"

# 2. JWT Oturum Gizli Anahtarı (Zorunlu - rastgele 32+ karakter)
AUTH_SECRET="evotopilot_super_secret_session_key_2026_production"

# 3. Yönetici Paneli Master Şifresi (İsteğe Bağlı)
ADMIN_PASSWORD="evos2026"

# 4. Canlı Site URL'si (Zorunlu)
NEXT_PUBLIC_SITE_URL="https://evotopilot.com"

# 5. Cloudinary Görsel Yönetimi (İsteğe Bağlı - görseller için)
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# 6. Node Ortamı ve Port (Hostinger otomatik atar, gerekirse elle yazılır)
NODE_ENV="production"
PORT=3000
