// Evos Gazete - Elektrikli Araç Haber Platformu
// MongoDB + Prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Category {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  slug        String    @unique
  description String?
  color       String    @default("#e30613")
  icon        String?
  order       Int       @default(0)
  isMainNav   Boolean   @default(false)
  isSideNav   Boolean   @default(true)
  href        String?
  articles    Article[]
  createdAt   DateTime  @default(now())

  @@index([order])
}

model Author {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  slug      String    @unique
  title     String?
  bio       String?
  avatar    String?
  twitter   String?
  articles  Article[]
  createdAt DateTime  @default(now())
}

model Article {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  slug        String    @unique
  spot        String
  content     String
  image       String
  imageCredit String?
  gallery     String[]  @default([])
  tags        String[]  @default([])
  categoryId  String    @db.ObjectId
  category    Category  @relation(fields: [categoryId], references: [id])
  authorId    String?   @db.ObjectId
  author      Author?   @relation(fields: [authorId], references: [id])
  isFeatured  Boolean   @default(false)
  isBreaking  Boolean   @default(false)
  isHeadline  Boolean   @default(false)
  isVideo     Boolean   @default(false)
  views       Int       @default(0)
  readTime    Int       @default(3)
  publishedAt DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  comments    Comment[]
  likes       ArticleLike[]
  bookmarks   Bookmark[]
  posts       Post[]

  @@index([categoryId, publishedAt])
  @@index([publishedAt])
  @@index([views])
}

model Comment {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  articleId String   @db.ObjectId
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  // Üyelik öncesi yorumlarda userId boştur, name alanı kullanılır
  userId    String?  @db.ObjectId
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  body      String
  likes     Int      @default(0)
  approved  Boolean  @default(true)
  // Yanıt zinciri: üst yorumun id'si
  parentId  String?  @db.ObjectId
  parent    Comment? @relation("CommentReplies", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies   Comment[] @relation("CommentReplies")

  commentLikes CommentLike[]
  createdAt DateTime @default(now())

  @@index([articleId, createdAt])
  @@index([userId, createdAt])
  @@index([parentId])
}

// ---------------------------------------------------------------------------
// Üyelik / sosyal katman
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  email        String   @unique
  username     String   @unique
  name         String
  passwordHash String
  avatar       String?
  bio          String?
  city         String?
  website      String?
  twitter      String?
  role         String   @default("uye") // uye | editor | admin
  isBanned     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  comments      Comment[]
  commentLikes  CommentLike[]
  articleLikes  ArticleLike[]
  bookmarks     Bookmark[]
  following     Follow[]       @relation("Follower")
  followers     Follow[]       @relation("Following")
  notifications Notification[] @relation("NotificationOwner")
  actorOf       Notification[] @relation("NotificationActor")

  // Sosyal katman
  posts            Post[]        @relation("PostAuthor")
  postLikes        PostLike[]
  postComments     PostComment[]
  friendsRequested Friendship[]  @relation("FriendRequester")
  friendsReceived  Friendship[]  @relation("FriendAddressee")

  @@index([createdAt])
}

model CommentLike {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  commentId String   @db.ObjectId
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([commentId, userId])
  @@index([userId])
}

model ArticleLike {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  articleId String   @db.ObjectId
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([articleId, userId])
  @@index([userId, createdAt])
}

model Bookmark {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  articleId String   @db.ObjectId
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([articleId, userId])
  @@index([userId, createdAt])
}

model Follow {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  followerId  String   @db.ObjectId
  follower    User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String   @db.ObjectId
  following   User     @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followingId])
}

model Notification {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation("NotificationOwner", fields: [userId], references: [id], onDelete: Cascade)
  actorId   String?  @db.ObjectId
  actor     User?    @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)
  // reply | comment_like | follow
  type      String
  message   String
  href      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead, createdAt])
}

// ---------------------------------------------------------------------------
// Sosyal katman: gönderi (metin/görsel) + reel (dikey video) + arkadaşlık
// ---------------------------------------------------------------------------

/**
 * Tek gönderi modeli. `kind` alanı metin gönderisini reel'den ayırır;
 * beğeni / yorum / görünürlük / akış mantığı ikisinde de aynı olduğu için
 * ayrı model tutulmaz.
 */
model Post {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  kind     String @default("text") // text | reel
  authorId String @db.ObjectId
  author   User   @relation("PostAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  body   String   @default("")
  images String[] @default([])
  tags   String[] @default([])

  // Reel alanları (kind = "reel")
  videoUrl    String?
  posterUrl   String?
  durationSec Int     @default(0)

  // public: herkes · friends: yalnızca arkadaşlar · private: yalnızca sahibi
  visibility String @default("public")

  // Gönderinin bağlandığı gazete içeriği (opsiyonel)
  articleId String?  @db.ObjectId
  article   Article? @relation(fields: [articleId], references: [id], onDelete: SetNull)
  vehicleId String?  @db.ObjectId
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  listingId String?  @db.ObjectId
  listing   Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)

  likeCount    Int     @default(0)
  commentCount Int     @default(0)
  views        Int     @default(0)
  isHidden     Boolean @default(false) // moderasyon: yayından kaldırıldı

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  likes    PostLike[]
  comments PostComment[]

  @@index([authorId, createdAt])
  @@index([kind, createdAt])
  @@index([createdAt])
  @@index([articleId])
}

model PostLike {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  postId    String   @db.ObjectId
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([userId, createdAt])
}

model PostComment {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  postId    String   @db.ObjectId
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([postId, createdAt])
  @@index([userId])
}

/**
 * Arkadaşlık: takipten farklı olarak çift yönlü ve onaya tabidir.
 * Takip = "içeriğini akışımda gör" (tek yönlü, herkese açık)
 * Arkadaşlık = "arkadaşa özel paylaşımlarımı gör" (karşılıklı, onaylı)
 */
model Friendship {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  requesterId String @db.ObjectId
  requester   User   @relation("FriendRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId String @db.ObjectId
  addressee   User   @relation("FriendAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  status      String    @default("pending") // pending | accepted
  createdAt   DateTime  @default(now())
  respondedAt DateTime?

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@index([requesterId, status])
}

model Vehicle {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  brand        String
  model        String
  slug         String   @unique
  year         Int
  segment      String
  bodyType     String
  image        String
  price        Int
  otvRate      Int      @default(10)
  rangeKm      Int
  batteryKwh   Float
  motorPowerKw Int
  motorPowerHp Int
  acceleration Float
  topSpeed     Int
  dcChargeKw   Int
  chargeMin    Int
  consumption  Float
  trunkLiter   Int
  driveType    String   @default("RWD")
  warranty     String   @default("8 yıl / 160.000 km")
  isFeatured   Boolean  @default(false)
  rating       Float    @default(4.5)
  pros         String[] @default([])
  cons         String[] @default([])
  description  String   @default("")
  createdAt    DateTime @default(now())
  posts        Post[]

  @@index([brand])
  @@index([price])
}

model ChargeStation {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  slug        String   @unique
  operator    String
  city        String
  district    String
  address     String
  lat         Float
  lng         Float
  socketCount Int
  maxPowerKw  Int
  socketTypes String[] @default([])
  pricePerKwh Float
  isFast      Boolean  @default(false)
  is24h       Boolean  @default(true)
  amenities   String[] @default([])
  status      String   @default("aktif")
  createdAt   DateTime @default(now())

  @@index([city])
  @@index([operator])
}

model Listing {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  title         String
  slug          String   @unique
  brand         String
  model         String
  year          Int
  km            Int
  price         Int
  city          String
  image         String
  images        String[] @default([])
  sellerType    String   @default("Galeri")
  sellerName    String
  batteryHealth Int      @default(95)
  rangeKm       Int
  color         String
  damage        String   @default("Hasarsız")
  isSponsored   Boolean  @default(false)
  description   String   @default("")
  createdAt     DateTime @default(now())
  posts         Post[]

  @@index([brand])
  @@index([price])
  @@index([city])
}

model CommunityPost {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  slug      String   @unique
  body      String
  author    String
  avatar    String?
  topic     String
  likes     Int      @default(0)
  replies   Int      @default(0)
  isPinned  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([topic])
}

model Ticker {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  label     String
  value     String
  unit      String?
  changePct Float    @default(0)
  order     Int      @default(0)
  updatedAt DateTime @updatedAt
}

model PriceIndex {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  month        String
  order        Int
  avgEvPrice   Int
  avgIcePrice  Int
  acChargeCost Float
  dcChargeCost Float
  fuelCost     Float
  batteryUsd   Int
  evShare      Float
  createdAt    DateTime @default(now())

  @@index([order])
}

model OtvBracket {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  label       String
  motorMaxKw  Int
  priceMin    Int
  priceMax    Int
  rate        Int
  order       Int      @default(0)
  note        String?
}

model Poll {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  question  String
  slug      String   @unique
  options   String[]
  votes     Int[]
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Subscriber {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  city      String?
  createdAt DateTime @default(now())
}

model Lead {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String
  phone     String?
  topic     String   @default("genel")
  message   String
  status    String   @default("yeni")
  createdAt DateTime @default(now())
}
