// Evos Gazete - Elektrikli Araç Haber Platformu
// MongoDB + Prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Category {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  slug        String    @unique
  description String?
  color       String    @default("#e30613")
  icon        String?
  order       Int       @default(0)
  isMainNav   Boolean   @default(false)
  isSideNav   Boolean   @default(true)
  href        String?
  articles    Article[]
  createdAt   DateTime  @default(now())

  @@index([order])
}

model Author {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  slug      String    @unique
  title     String?
  bio       String?
  avatar    String?
  twitter   String?
  articles  Article[]
  createdAt DateTime  @default(now())
}

model Article {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  slug        String   @unique
  spot        String
  content     String
  image       String
  imageCredit String?
  gallery     String[] @default([])
  tags        String[] @default([])
  categoryId  String   @db.ObjectId
  category    Category @relation(fields: [categoryId], references: [id])
  authorId    String?  @db.ObjectId
  author      Author?  @relation(fields: [authorId], references: [id])
  isFeatured  Boolean  @default(false)
  isBreaking  Boolean  @default(false)
  isHeadline  Boolean  @default(false)
  isVideo     Boolean  @default(false)
  views       Int      @default(0)
  readTime    Int      @default(3)
  publishedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // --- Yayın durumu ve kaynak izlenebilirliği (ingest) ---
  // status: DRAFT (moderasyon kuyruğunda) | PUBLISHED (yayında) | REJECTED (reddedildi)
  status      String    @default("PUBLISHED")
  sourceName  String? // "Kaynak Adı" — agregatörde zorunlu atıf
  sourceUrl   String? // orijinal habere kanonik link
  externalId  String? // kaynaktaki benzersiz kimlik (RSS guid)
  contentHash String? // içerik değişti mi tespiti için
  ingestedAt  DateTime? // otomatik çekildiği an (elle girilenlerde null)

  // --- Yeniden yazım (telif güvenliği) ---
  // Metin kaynaktan kopyalanmaz; LLM ile sıfırdan yeniden yazılır. Yalnızca
  // rewrittenAt dolu olan otomatik haberler yayına çıkabilir.
  rewrittenAt     DateTime?
  rewriteModel    String?
  rewriteAttempts Int       @default(0)
  rewriteError    String?

  comments  Comment[]
  likes     ArticleLike[]
  bookmarks Bookmark[]
  posts     Post[]

  @@index([categoryId, publishedAt])
  @@index([publishedAt])
  @@index([views])
  @@index([status, publishedAt])
  @@index([externalId])
  @@index([contentHash])
  // Yeniden yazım kuyruğu: henüz yazılmamış taslakları sıraya almak için.
  @@index([sourceName, rewrittenAt, rewriteAttempts])
  // Arşiv temizliği: 30 günden eski otomatik haberleri bulmak için.
  @@index([ingestedAt])
}

model Comment {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  articleId String    @db.ObjectId
  article   Article   @relation(fields: [articleId], references: [id], onDelete: Cascade)
  // Üyelik öncesi yorumlarda userId boştur, name alanı kullanılır
  userId    String?   @db.ObjectId
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  body      String
  likes     Int       @default(0)
  approved  Boolean   @default(true)
  // Yanıt zinciri: üst yorumun id'si
  parentId  String?   @db.ObjectId
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies   Comment[] @relation("CommentReplies")

  commentLikes CommentLike[]
  createdAt    DateTime      @default(now())

  @@index([articleId, createdAt])
  @@index([userId, createdAt])
  @@index([parentId])
}

// ---------------------------------------------------------------------------
// Üyelik / sosyal katman
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  email        String   @unique
  username     String   @unique
  name         String
  passwordHash String
  avatar       String?
  bio          String?
  city         String?
  website      String?
  twitter      String?
  role         String   @default("uye") // uye | editor | admin
  isBanned     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  comments      Comment[]
  commentLikes  CommentLike[]
  articleLikes  ArticleLike[]
  bookmarks     Bookmark[]
  following     Follow[]       @relation("Follower")
  followers     Follow[]       @relation("Following")
  notifications Notification[] @relation("NotificationOwner")
  actorOf       Notification[] @relation("NotificationActor")

  // Sosyal katman
  posts            Post[]        @relation("PostAuthor")
  postLikes        PostLike[]
  postComments     PostComment[]
  friendsRequested Friendship[]  @relation("FriendRequester")
  friendsReceived  Friendship[]  @relation("FriendAddressee")

  // Pazaryeri
  listings         Listing[]         @relation("ListingSeller")
  listingFavorites ListingFavorite[]

  @@index([createdAt])
}

model CommentLike {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  commentId String   @db.ObjectId
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([commentId, userId])
  @@index([userId])
}

model ArticleLike {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  articleId String   @db.ObjectId
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([articleId, userId])
  @@index([userId, createdAt])
}

model Bookmark {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  articleId String   @db.ObjectId
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([articleId, userId])
  @@index([userId, createdAt])
}

model Follow {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  followerId  String   @db.ObjectId
  follower    User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String   @db.ObjectId
  following   User     @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followingId])
}

model Notification {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation("NotificationOwner", fields: [userId], references: [id], onDelete: Cascade)
  actorId   String?  @db.ObjectId
  actor     User?    @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)
  // reply | comment_like | follow
  type      String
  message   String
  href      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead, createdAt])
}

// ---------------------------------------------------------------------------
// Sosyal katman: gönderi (metin/görsel) + reel (dikey video) + arkadaşlık
// ---------------------------------------------------------------------------

/**
 * Tek gönderi modeli. `kind` alanı metin gönderisini reel'den ayırır;
 * beğeni / yorum / görünürlük / akış mantığı ikisinde de aynı olduğu için
 * ayrı model tutulmaz.
 */
model Post {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  kind     String @default("text") // text | reel
  authorId String @db.ObjectId
  author   User   @relation("PostAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  body   String   @default("")
  images String[] @default([])
  tags   String[] @default([])

  // Reel alanları (kind = "reel")
  videoUrl    String?
  posterUrl   String?
  durationSec Int     @default(0)

  // public: herkes · friends: yalnızca arkadaşlar · private: yalnızca sahibi
  visibility String @default("public")

  // Gönderinin bağlandığı gazete içeriği (opsiyonel)
  articleId String?  @db.ObjectId
  article   Article? @relation(fields: [articleId], references: [id], onDelete: SetNull)
  vehicleId String?  @db.ObjectId
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  listingId String?  @db.ObjectId
  listing   Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)

  likeCount    Int     @default(0)
  commentCount Int     @default(0)
  views        Int     @default(0)
  isHidden     Boolean @default(false) // moderasyon: yayından kaldırıldı

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  likes    PostLike[]
  comments PostComment[]

  @@index([authorId, createdAt])
  @@index([kind, createdAt])
  @@index([createdAt])
  @@index([articleId])
}

model PostLike {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  postId    String   @db.ObjectId
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([userId, createdAt])
}

model PostComment {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  postId    String   @db.ObjectId
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([postId, createdAt])
  @@index([userId])
}

/**
 * Arkadaşlık: takipten farklı olarak çift yönlü ve onaya tabidir.
 * Takip = "içeriğini akışımda gör" (tek yönlü, herkese açık)
 * Arkadaşlık = "arkadaşa özel paylaşımlarımı gör" (karşılıklı, onaylı)
 */
model Friendship {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  requesterId String @db.ObjectId
  requester   User   @relation("FriendRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId String @db.ObjectId
  addressee   User   @relation("FriendAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  status      String    @default("pending") // pending | accepted
  createdAt   DateTime  @default(now())
  respondedAt DateTime?

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@index([requesterId, status])
}

model Vehicle {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  brand        String
  model        String
  slug         String   @unique
  year         Int
  segment      String
  bodyType     String
  image        String
  images       String[] @default([])
  marketStatus String   @default("TR_YAYINDA") // "TR_YAYINDA" | "TR_YAKINDA" | "TR_YOK"
  price        Int
  otvRate      Int      @default(10)
  rangeKm      Int
  batteryKwh   Float
  motorPowerKw Int
  motorPowerHp Int
  acceleration Float
  topSpeed     Int
  consumption  Float
  driveType    String   @default("RWD")
  isFeatured   Boolean  @default(false)
  pros         String[] @default([])
  cons         String[] @default([])
  description  String   @default("")

  // --- Doğrulanabilir bir kaynağı olmayan alanlar ---
  // Bu değerler için ücretsiz ve güvenilir bir toplu veri kaynağı yok; uydurmak
  // yerine boş bırakılır ve /admin/araclar üzerinden operatör doldurur.
  // Arayüz boş değerleri "—" olarak gösterir, hesaplamalarda atlar.
  dcChargeKw Int?
  chargeMin  Int?
  trunkLiter Int?
  warranty   String?
  /// Editör puanı. Otomatik atanmaz; yalnızca gerçek bir inceleme yapıldıysa dolar.
  rating     Float?

  /// GERÇEK MEVSİMSEL MENZİL
  /// `rangeKm` üreticinin ilan ettiği WLTP değeridir; gerçek kullanımda yazın
  /// klima, kışın ısıtma ve batarya sıcaklığı bunu düşürür. Bu iki alan ölçüme
  /// dayalı değerler içindir ve ölçüm yoksa BOŞ kalır — WLTP'den bir katsayıyla
  /// türetmek uydurma veri üretmek olurdu.
  rangeSummerKm Int?
  rangeWinterKm Int?
  /// Mevsimsel menzilin nereden geldiği (ör. "EV Database WLTP city/highway").
  rangeSource   String?
  createdAt    DateTime @default(now())
  posts        Post[]
  listings     Listing[]

  // --- Kaynak izlenebilirliği ---
  externalId     String?
  priceSource    String? // fiyatın alındığı kaynak (marka listesi / elle)
  priceUpdatedAt DateTime? // fiyat ne zaman doğrulandı

  @@index([brand])
  @@index([price])
  @@index([externalId])
}

model ChargeStation {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  slug        String   @unique
  operator    String
  city        String
  district    String
  address     String
  lat         Float
  lng         Float
  socketCount Int
  socketTypes String[] @default([])
  isFast      Boolean  @default(false)
  amenities   String[] @default([])
  status      String   @default("aktif")
  createdAt   DateTime @default(now())

  // --- Kaynakta her zaman bulunmayan alanlar ---
  // Open Charge Map kayıtlarının bir kısmında güç bilgisi yok; tarife ve
  // 7/24 bilgisi ise OCM'de hiç tutulmaz. Uydurmak yerine boş bırakılır,
  // arayüz "—" gösterir ve ortalamalara dâhil etmez. Operatör /admin/istasyonlar
  // üzerinden doldurabilir.
  maxPowerKw  Int?
  pricePerKwh Float?
  is24h       Boolean?

  // --- Kaynak izlenebilirliği ---
  source     String? // "openchargemap" | "manuel"
  externalId String? // OCM POI ID
  fetchedAt  DateTime?

  @@index([city])
  @@index([operator])
  @@index([externalId])
}

model Listing {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  title         String
  slug          String   @unique
  brand         String
  model         String
  year          Int
  km            Int
  price         Int
  city          String
  image         String
  images        String[] @default([])
  sellerType    String   @default("Galeri")
  sellerName    String
  batteryHealth Int      @default(95)
  rangeKm       Int
  color         String
  damage        String   @default("Hasarsız")
  isSponsored   Boolean  @default(false)
  description   String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  posts         Post[]

  /// SIFIR | IKINCI_EL — sıfır araç ilanları katalogla eşleşir, ikinci el
  /// ilanlarda batarya raporu ve VoltScore devreye girer.
  condition String @default("IKINCI_EL")

  /// PENDING | PUBLISHED | REJECTED | SOLD
  /// İlan üyeden gelir ve moderasyondan geçmeden yayına ÇIKMAZ.
  status String @default("PENDING")

  /// İlanı veren üye. Panelden girilen ilanlarda boş kalabilir.
  userId String? @db.ObjectId
  user   User?   @relation("ListingSeller", fields: [userId], references: [id], onDelete: SetNull)

  /// Katalogdaki modelle bağ — teknik veriyi ilanda tekrar girmeye gerek kalmaz.
  vehicleId String?  @db.ObjectId
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  /// --- VoltScore girdileri ---
  /// Hiçbiri zorunlu değildir; eksik kriter puanlamada ATLANIR ve ağırlığı
  /// kalan kriterlere dağıtılır (bkz. lib/voltscore.ts). Varsayılan bir değer
  /// yazmak, bilinmeyen bir aracı bilinen gibi göstermek olurdu.
  warrantyMonthsLeft Int?
  /// TAM | KISMI | YOK
  serviceHistory     String?
  /// DUSUK | ORTA | YUKSEK — DC hızlı şarj kullanım yoğunluğu
  fastChargeHabit    String?
  /// Kullanıcının bildirdiği gerçek menzil; katalog menziliyle uyumu puanlanır.
  realRangeKm        Int?

  /// Sunucuda hesaplanan güven puanı (0-100). Girdiler değiştikçe yeniden yazılır.
  voltScore     Int?
  voltScoreAt   DateTime?
  /// Kriter kırılımı — kullanıcıya "puan neden bu?" diye gösterilir.
  voltScoreBreakdown Json?

  batteryReport BatteryReport?
  favorites     ListingFavorite[]

  @@index([brand])
  @@index([price])
  @@index([city])
  @@index([status, createdAt])
  @@index([condition])
  @@index([userId])
}

model BatteryReport {
  /// DOĞRULANMIŞ BATARYA RAPORU
  ///
  /// İkinci el elektrikli araçta en pahalı bileşen bataryadır ve gözle
  /// kontrol edilemez. Bu model, yetkili servis veya ekspertiz firmasının
  /// ÖLÇTÜĞÜ değerleri tutar; kalan ömür ve risk seviyesi bu ölçümlerden
  /// SUNUCUDA hesaplanır (bkz. lib/battery-report.ts) — elle girilmez.
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  listingId String  @unique @db.ObjectId
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  /// --- ÖLÇÜLEN DEĞERLER ---
  /// State of Health: fabrika kapasitesine göre kalan yüzde. Broşür değeri değil.
  sohPercent      Float
  /// Tam şarj çevrimi sayısı.
  cycleCount      Int?
  /// Toplam şarjın yüzde kaçı DC hızlı şarj (0-100).
  fastChargeRatio Int?
  odometerKm      Int?

  /// --- HESAPLANAN DEĞERLER (sunucu) ---
  estimatedYearsLeft Float?
  /// DUSUK | ORTA | YUKSEK
  riskLevel          String?

  /// --- İZLENEBİLİRLİK ---
  measuredBy String
  measuredAt DateTime
  /// Rapor Evos tarafından doğrulanana kadar ilanda rozet ÇIKMAZ.
  verifiedAt DateTime?
  verifiedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([verifiedAt])
}

model ListingFavorite {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  listingId String   @db.ObjectId
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([listingId, userId])
  @@index([userId])
}

model GarageFeature {
  /// DİJİTAL GARAJ — MODEL BAZLI YAZILIM ÖZELLİĞİ
  ///
  /// Aynı modelin donanım paketine göre bir özelliği olabilir ya da olmayabilir;
  /// bazıları ayrı abonelik ister. Durum bu yüzden dört değerlidir.
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  brand  String
  model  String
  /// Katalogdaki araca bağ (varsa).
  vehicleSlug String?
  name   String
  /// AKTIF | OPSIYONEL | ABONELIK | PASIF
  status String @default("AKTIF")
  /// "GT-Line paketi", "Uygulamadan", "Yalnızca GT donanımı" gibi koşul notu.
  note   String?
  order  Int    @default(0)

  /// Bilginin alındığı yer (marka donanım listesi / kullanım kılavuzu).
  source String?
  verifiedAt DateTime?

  @@unique([brand, model, name])
  @@index([brand, model])
}

model CommunityPost {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  slug      String   @unique
  body      String
  author    String
  avatar    String?
  topic     String
  likes     Int      @default(0)
  replies   Int      @default(0)
  isPinned  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([topic])
}

model Ticker {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  label     String
  value     String
  unit      String?
  changePct Float    @default(0)
  order     Int      @default(0)
  updatedAt DateTime @updatedAt

  // --- Kaynak izlenebilirliği ---
  key       String? // "usd" | "eur" | "brent" — otomatik güncellenenler için sabit anahtar
  source    String? // "tcmb" | "manuel"
  fetchedAt DateTime?

  @@index([key])
}

/**
 * Aylık pazar anlık görüntüsü.
 *
 * `avgEvPrice`, `avgRangeKm` ve `modelCount` her ay kataloğun gerçek
 * içeriğinden hesaplanır (bkz. lib/ingest/sources/price-index.ts).
 * Kalan alanlar için ücretsiz ve güvenilir bir veri kaynağı bulunmadığından
 * boş bırakılır; operatör doğrulanmış değer girerse dolar, girmezse arayüz
 * ilgili grafiği hiç göstermez.
 */
model PriceIndex {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  /// "2026-08" — ay başına tek kayıt.
  period     String   @unique
  month      String
  order      Int
  avgEvPrice Int
  avgRangeKm Int      @default(0)
  modelCount Int      @default(0)
  createdAt  DateTime @default(now())

  // --- Doğrulanmış kaynağı olmayan, operatörün girebileceği alanlar ---
  avgIcePrice  Int?
  acChargeCost Float?
  dcChargeCost Float?
  fuelCost     Float?
  batteryUsd   Int?
  evShare      Float?

  // --- Kaynak izlenebilirliği ---
  source    String? // "katalog" (türetilmiş) | "manuel"
  fetchedAt DateTime?

  @@index([order])
}

model OtvBracket {
  id         String  @id @default(auto()) @map("_id") @db.ObjectId
  label      String
  motorMaxKw Int
  priceMin   Int
  priceMax   Int
  rate       Int
  order      Int     @default(0)
  note       String?
}

model Poll {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  question  String
  slug      String   @unique
  options   String[]
  votes     Int[]
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Subscriber {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  city      String?
  createdAt DateTime @default(now())
}

model Lead {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String
  phone     String?
  topic     String   @default("genel")
  message   String
  status    String   @default("yeni")
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// VERİ KAYNAKLARI — otomatik içerik/veri akışının kaydı ve izlenebilirliği
// ---------------------------------------------------------------------------

model DataSource {
  /// Dış kaynak tanımı. Cron bu tabloyu okuyup hangi kaynağın çalışacağına karar verir.
  id          String      @id @default(auto()) @map("_id") @db.ObjectId
  key         String      @unique // "tcmb" | "openchargemap" | "news:otomobil"
  name        String
  kind        String // news | stations | fx | prices
  endpoint    String?
  /// Haber kaynakları için: çekilen içeriğin düşeceği kategori slug'ı.
  categorySlug String?
  /// Konu filtresi: doluysa yalnızca bu kelimeleri içeren başlıklar kuyruğa girer.
  /// Genel teknoloji beslemelerinden yalnızca elektrikli araç haberlerini ayıklar.
  keywords     String[] @default([])
  attribution String? // yayında gösterilecek atıf metni
  schedule    String      @default("") // bilgi amaçlı cron ifadesi
  isActive    Boolean     @default(true)
  autoPublish Boolean     @default(false) // false ise kayıtlar DRAFT olarak düşer
  lastRunAt   DateTime?
  lastOkAt    DateTime?
  lastError   String?
  runs        IngestRun[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([kind, isActive])
}

model IngestRun {
  /// Her cron çalışmasının sonucu. Panelde "veri ne kadar taze" göstergesini besler.
  id         String      @id @default(auto()) @map("_id") @db.ObjectId
  sourceKey  String
  sourceId   String?     @db.ObjectId
  source     DataSource? @relation(fields: [sourceId], references: [id])
  status     String // ok | partial | error
  fetched    Int         @default(0)
  created    Int         @default(0)
  updated    Int         @default(0)
  skipped    Int         @default(0)
  failed     Int         @default(0)
  durationMs Int         @default(0)
  error      String?
  startedAt  DateTime    @default(now())
  finishedAt DateTime?

  @@index([sourceKey, startedAt])
  @@index([startedAt])
}

model OperatorTariff {
  /// ŞARJ OPERATÖRÜ TARİFESİ
  ///
  /// Open Charge Map istasyon envanterinde tarife bilgisi YOKTUR; operatörler
  /// fiyatlarını yalnızca kendi sitelerinde yayımlar. Bu model o fiyatları
  /// operatör bazında, kaynağı ve doğrulama tarihiyle birlikte tutar.
  /// Fiyat kademeleri operatörlerin ilan ettiği yapıyla aynıdır:
  /// AC (≤22 kW) / DC hızlı (<150 kW) / DC ultra (≥150 kW).
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  operator String @unique
  slug     String @unique

  /// Open Charge Map operatör adları bizimkiyle birebir aynı olmayabiliyor
  /// ("ZES" ↔ "ZES (Zorlu)"). Otomatik eşleşmenin tutmadığı durumlarda
  /// panelden ek ad yazılır.
  aliases String[] @default([])

  /// Operatör tek fiyat ilan ettiyse yalnızca alt sınır dolar; aralık
  /// ilan ettiyse (ör. sokete göre değişen AC fiyatı) üst sınır da yazılır.
  /// Operatörün o kademede hizmeti yoksa alan BOŞ kalır ve arayüz "—" gösterir.
  acPrice       Float?
  acPriceMax    Float?
  dcPrice       Float?
  dcPriceMax    Float?
  ultraPrice    Float?
  ultraPriceMax Float?

  website String?
  /// Kademe sınırı, kampanya, bölgesel fark gibi operatöre özel açıklama.
  note    String?

  /// --- Kaynak izlenebilirliği ---
  /// Her satır ya bir dış derlemeden ya da operatörün kendi ilanından gelir;
  /// kaynağı olmayan fiyat yazılmaz.
  source     String? // "volthaber" | "operator" | "manuel"
  sourceUrl  String?
  verifiedAt DateTime?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

// ==========================================
// OCPI v2.2.1 MODELLERİ (eMSP ve CPO Entegrasyonu)
// ==========================================

model OcpiLocation {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  countryCode String   // Örn: "TR"
  partyId     String   // Örn: "ZES"
  locationId  String   // Operatörün kendi sistemindeki tekil ID
  name        String
  address     String
  city        String?
  postalCode  String?
  country     String   @default("TUR")
  latitude    Float
  longitude   Float
  publish     Boolean  @default(true)
  evses       OcpiEvse[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([countryCode, partyId, locationId])
  @@index([city])
}

model OcpiEvse {
  id          String          @id @default(auto()) @map("_id") @db.ObjectId
  uid         String          @unique // Örn: "TR*ZES*E1024"
  evseId      String?         // Opsiyonel resmi EVSE ID
  status      String          // AVAILABLE, CHARGING, RESERVED, OUTOFORDER, BLOCKED
  locationId  String          @db.ObjectId
  location    OcpiLocation    @relation(fields: [locationId], references: [id], onDelete: Cascade)
  connectors  OcpiConnector[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([locationId])
}

model OcpiConnector {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  connectorId String    // CPO içindeki connector numarası (örn: "1")
  standard    String    // IEC_62196_T2, IEC_62196_T2_COMBO (CCS2), CHADEMO
  format      String    // CABLE, SOCKET
  powerType   String    // AC_1_PHASE, AC_3_PHASE, DC
  voltage     Int
  amperage    Int
  maxPowerKw  Int
  evseId      String    @db.ObjectId
  evse        OcpiEvse  @relation(fields: [evseId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([evseId])
}

model OcpiToken {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  token       String   @unique
  partyId     String
  countryCode String
  role        String   @default("CPO") // CPO, eMSP
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
